  // ----------------------------------------------------------------------------
  // Backstory: the Thakur cold case (December 2011)
  // ----------------------------------------------------------------------------

  "backstory": [
    {
      "id": "thakur-murders-2011",
      "title": "The Thakur Family Murders",
      "whenText": "December 2011 — fifteen years ago",
      "summary": "On a cold December night fifteen years ago, Thakur Cottage in Landour was broken into. Three members of the Thakur family — Brigadier Ranjit Thakur (retired), his wife Meera, and his elderly mother — were killed during what police called a robbery gone wrong. The case was investigated by then-Sub-Inspector Devraj Khanna and quickly went cold.",
      "fullDescription": "There were no thieves. Rajveer Bisht — whose father Harish Bisht had been driven to a heart attack months earlier by the Brigadier's vindictive use of army connections to revoke his hotel licence — hired two migrant labourers from outside Mussoorie to kill the family. The robbery was a staging: a few items were taken to make it look like burglars (the Brigadier's medals, the wife's gold, a British-era Enfield rifle). The men left town that night and were never seen again. Devraj had been bribed in advance to ensure the investigation went nowhere. After the killings, Bisht began acquiring land around Thakur Cottage through proxy buyers and shell companies. Over fifteen years he built the Royal Pines Hotel on what had once been Thakur land. He kept the Enfield rifle — supposedly to be destroyed — and mounted it in his private office as a trophy.",
      "revealedByEvidence": [
        "anonymous-letter-2",
        "old-newspaper-clipping",
        "theft-fir-inventory",
        "wall-mount-photo",
        "office-rifle-photo",
        "land-registry",
        "bisht-family-history"
      ],
      "characters": [
        {
          "id": "brigadier-thakur",
          "name": "Brigadier Ranjit Thakur (retd.)",
          "role": "Mussoorie patriarch, deceased 2011",
          "summary": "Old Mussoorie money. Respected, feared. Used army connections like a weapon. Drove a small hotelier to financial ruin and never imagined the consequences."
        },
        {
          "id": "meera-thakur",
          "name": "Meera Thakur",
          "role": "The Brigadier's wife, deceased 2011",
          "summary": "Quiet, dignified, kept the cottage. Killed alongside her husband and mother-in-law."
        },
        {
          "id": "thakur-mother",
          "name": "The Brigadier's mother",
          "role": "Family elder, deceased 2011",
          "summary": "Lived with her son and daughter-in-law. Third casualty of the staged robbery."
        },
        {
          "id": "harish-bisht",
          "name": "Harish Bisht",
          "role": "Mr. Bisht's father, deceased 2011 (heart attack)",
          "summary": "A small-time hotelier whose licence was revoked through the Brigadier's influence. Died of a heart attack six months later. His destruction is the reason for everything that followed."
        }
      ]
    }
  ],

