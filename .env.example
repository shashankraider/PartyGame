# Optional: pin the app to one case instead of showing the picker.
CASE_ID=mussoorie

# Supabase, used from Phase 2b onward.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2h Realtime: short-lived session JWTs are signed with this secret.
# It must match the Supabase project's JWT secret (Settings → API → JWT Secret).
# When unset, the client falls back to the legacy polling helpers automatically.
SUPABASE_JWT_SECRET=

# OpenRouter interview route.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
NEXT_PUBLIC_APP_URL=http://localhost:3000
